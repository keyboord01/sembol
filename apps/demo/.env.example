# Sembol demo - Stellar testnet configuration.
# Everything has a working testnet default baked in; the app runs with NO env vars.

# Stellar network
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# smart-account-kit testnet deployment (see stellar/smart-account-kit demo/.env.example
# for the current values - testnet resets can invalidate these)
NEXT_PUBLIC_ACCOUNT_WASM_HASH=a12e8fa9621efd20315753bd4007d974390e31fbcb4a7ddc4dd0a0dec728bf2e
NEXT_PUBLIC_WEBAUTHN_VERIFIER_ADDRESS=CBSHV66WG7UV6FQVUTB67P3DZUEJ2KJ5X6JKQH5MFRAAFNFJUAJVXJYV
NEXT_PUBLIC_NATIVE_TOKEN_CONTRACT=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Optional: fee sponsoring via OpenZeppelin Relayer (Stellar Channels).
# Testnet API keys are self-serve:  curl https://channels.openzeppelin.com/testnet/gen
# Point the client at the built-in proxy route, and give the proxy your credentials -
# the API key stays server-side.
#
# CAUTION: once NEXT_PUBLIC_RELAYER_URL is set, ALL submissions go through the
# relayer (no automatic RPC fallback) - leave unset to submit via RPC (fine on testnet).
# The proxy is same-origin only unless you allow-list an origin explicitly.
# NEXT_PUBLIC_RELAYER_URL=/api/relayer
# RELAYER_UPSTREAM_URL=https://channels.openzeppelin.com/testnet/
# RELAYER_API_KEY=<uuid from /gen>
# RELAYER_ALLOWED_ORIGIN=https://your-storybook.example.com

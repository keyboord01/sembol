# Sembol demo - Stellar testnet configuration.
# Everything has a working testnet default baked in; the app runs with NO env vars.

# Stellar network
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# smart-account-kit testnet deployment - the library's SEMBOL_TESTNET_ARTIFACTS
# preset is the source of truth; only set these if a testnet reset invalidated it
# (current values: stellar/smart-account-kit demo/.env.example).
# NEXT_PUBLIC_ACCOUNT_WASM_HASH=
# NEXT_PUBLIC_WEBAUTHN_VERIFIER_ADDRESS=
# NEXT_PUBLIC_NATIVE_TOKEN_CONTRACT=

# Fee sponsoring (relayer). Since smart-account-kit 0.5.0 wallet creation
# REQUIRES a relayer (the shared deployer is sign-only; no RPC fallback).
# Default: the preset's public SDF testnet proxy - the app runs with no env.
# To use your own OpenZeppelin Relayer Channels key instead, point the client
# at the built-in proxy route; the API key stays server-side.
# Testnet API keys are self-serve:  curl https://channels.openzeppelin.com/testnet/gen
# The proxy is same-origin only unless you allow-list an origin explicitly.
# NEXT_PUBLIC_RELAYER_URL=/api/relayer
# RELAYER_UPSTREAM_URL=https://channels.openzeppelin.com/testnet/
# RELAYER_API_KEY=<uuid from /gen>
# RELAYER_ALLOWED_ORIGIN=https://your-storybook.example.com
